# KARAVYA Backend - environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (SQLite via node:sqlite) ---
DATABASE_PATH=./data/karavya.db

# --- Session ---
# REQUIRED: long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
AUTH_SECRET=change-me-to-a-long-random-string
SESSION_TTL_MS=604800000

# --- CORS ---
# Comma-separated list of allowed frontend origins (never use * with credentials)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
FRONTEND_URL=http://localhost:3000

# --- Commerce rules (matches existing KARAVYA storefront behaviour) ---
SHIPPING_FLAT_CENTS=50000
FREE_SHIPPING_THRESHOLD_CENTS=500000
TAX_RATE=0.05

# --- Bootstrap admin (optional; used only if set) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# --- AI / KAYA (reserved - KAYA integration is a later phase) ---
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_ENDPOINT=

# --- Payment gateway (reserved - separate phase) ---
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET=

# --- Email (optional; without config, emails are logged to console in dev) ---
EMAIL_FROM=KARAVYA Maison <no-reply@karavya.example>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=